    {
      "cell_type": "code",
      "source": [
        "# 1. Factorial Recursivo: n! = n * (n - 1)! con caso base 0! = 1 o 1! = 1\n",
        "def factorial_recursivo(n):\n",
        "    if n <= 1:\n",
        "        return 1\n",
        "    return n * factorial_recursivo(n - 1)\n",
        "\n",
        "# 2. Fibonacci Iterativo: O(n) tiempo y O(1) espacio adicional\n",
        "def fibonacci_iterativo(n):\n",
        "    if n == 0:\n",
        "        return 0\n",
        "    elif n == 1:\n",
        "        return 1\n",
        "\n",
        "    a, b = 0, 1\n",
        "    for _ in range(2, n + 1):\n",
        "        a, b = b, a + b\n",
        "    return b\n",
        "\n",
        "# Pruebas rápidas de verificación\n",
        "print(\"Factorial recursivo de 5:\", factorial_recursivo(5))\n",
        "print(\"Fibonacci iterativo de 10:\", fibonacci_iterativo(10))"
